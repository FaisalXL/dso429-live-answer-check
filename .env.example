OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
REVISION_MODEL=anthropic/claude-sonnet-5.5
HINT_THRESHOLD=0.5
PASS_THRESHOLD=0.8
MAX_HINTS=3
DEMO_MODE=false
DEV_COSINE=false
# Password for /admin/export.csv. Leave empty to turn the export off.
ADMIN_KEY=
# Submissions after this time are refused. Example: 2026-11-22T23:59:00-08:00
CLOSES_AT=
STUDENT_EMAIL_PATTERN=^[A-Za-z0-9._%+-]+@usc\.edu$
STUDENT_EMAIL_HINT=your @usc.edu email
